 namespace {
+QString droppedProject(const QMimeData* mime)
+{
+    const auto urls = mime->urls();
+    if (urls.size() != 1 || !urls.front().isLocalFile()) return {};
+    const auto path = urls.front().toLocalFile();
+    return QFileInfo(path).suffix().compare("openroll", Qt::CaseInsensitive) == 0 ? path : QString{};
+}
+
+class OpenRollWindow final : public QMainWindow {
+public:
+    OpenRollWindow() { setAcceptDrops(true); }
+    std::function<void(const QString&)> openProject;
+protected:
+    void dragEnterEvent(QDragEnterEvent* event) override
+    {
+        if (!droppedProject(event->mimeData()).isEmpty() && event->possibleActions().testFlag(Qt::CopyAction)) {
+            event->setDropAction(Qt::CopyAction);
+            event->accept();
+        }
+    }
+    void dropEvent(QDropEvent* event) override
+    {
+        const auto path = droppedProject(event->mimeData());
+        if (path.isEmpty() || !event->possibleActions().testFlag(Qt::CopyAction)) return;
+        event->setDropAction(Qt::CopyAction);
+        event->accept();
+        QTimer::singleShot(0, this, [this, path] { openProject(path); });
+    }
+};
